{"id":1496,"date":"2015-07-23T16:21:51","date_gmt":"2015-07-23T23:21:51","guid":{"rendered":"http:\/\/ccra.us\/?p=1496"},"modified":"2018-08-15T07:24:34","modified_gmt":"2018-08-15T07:24:34","slug":"general-license-upgrade-class-begins-thursday-august-6th","status":"publish","type":"post","link":"http:\/\/ccra.us\/2015\/07\/23\/general-license-upgrade-class-begins-thursday-august-6th\/","title":{"rendered":"General license upgrade class begins Thursday August 6th"},"content":{"rendered":"<p style=\"text-align: center;\"><strong>Ham Radio Course Forming Now!<\/strong><\/p>\n<p style=\"text-align: center;\">The <strong>Salvation Army<\/strong> together with the<\/p>\n<p style=\"text-align: center;\"><strong>Mt. Diablo Amateur Radio Club<\/strong><\/p>\n<p style=\"text-align: center;\">will be holding an 8 week course where you can <strong><em>upgrade<\/em><\/strong> your <strong>Amateur Radio License<\/strong> to <strong><u>General Class<\/u><\/strong><\/p>\n<p><em>\u00a0<\/em><\/p>\n<p style=\"text-align: center;\"><strong>The General Class license is your gateway to all the world-wide Amateur bands of excitement and Emergency Communications on Ham Radio\u2026and you do NOT need to learn Morse code!<\/strong><\/p>\n<p style=\"text-align: center;\"><strong>\u00a0<\/strong><\/p>\n<p style=\"text-align: center;\"><strong>This course is to <u>upgrade<\/u> your current <u>Technician License<\/u><\/strong><\/p>\n<p style=\"text-align: center;\"><strong>Course begins on\u2026<\/strong><\/p>\n<p style=\"text-align: center;\"><strong>Thursday August 6<sup>th <\/sup>to <\/strong><\/p>\n<p style=\"text-align: center;\"><strong>September 24<sup>th<\/sup> at<\/strong><strong> 7-9 pm <\/strong><\/p>\n<p style=\"text-align: center;\"><strong>(First class starts at 6:30)<\/strong><\/p>\n<p style=\"text-align: center;\"><strong>The Salvation Army<\/strong><\/p>\n<p style=\"text-align: center;\"><strong>3950 Clayton Road, (at West St.)<\/strong><\/p>\n<p style=\"text-align: center;\"><strong>Concord 94521<\/strong><\/p>\n<p style=\"text-align: center;\"><em>\u00a0<\/em><\/p>\n<p><em>Registration is required<\/em><em>.<\/em><\/p>\n<p>Class is FREE but there is a $7 materials fee and Textbook if needed about $27.\u00a0 <strong><em>Each student must have full access to a copy of the text.<\/em><\/strong><\/p>\n<p>&nbsp;<\/p>\n<p style=\"text-align: center;\"><strong>License testing will also be available.<\/strong><\/p>\n<p style=\"text-align: center;\"><strong>Follow up training &#8211;<\/strong><\/p>\n<p style=\"text-align: center;\"><strong>Getting On The Air HF is October 8<sup>th<\/sup> and October 22<sup>nd<\/sup>.<\/strong><\/p>\n<p>&nbsp;<\/p>\n<p><strong>To sign up email:<\/strong><strong>\u00a0<a href=\"mailto:HamRadioClass@gmail.com\">HamRadioClass<\/a><\/strong><\/p>\n<p>&nbsp;<\/p>\n<p>For a PDF flyer please use this link <a href=\"http:\/\/ccra.us\/wp-content\/uploads\/2018\/08\/courseflyer-Gen2015-1.pdf\">courseflyer-Gen2015-1<\/a>.<\/p>\n","protected":false},"excerpt":{"rendered":"<p>Ham Radio Course Forming Now! The Salvation Army together with the Mt. Diablo Amateur Radio Club will be holding an 8 week course where you can upgrade your Amateur Radio <a class=\"more-link\" href=\"http:\/\/ccra.us\/2015\/07\/23\/general-license-upgrade-class-begins-thursday-august-6th\/\">Continue Reading &rarr;<\/a><\/p>\n","protected":false},"author":1,"featured_media":0,"comment_status":"closed","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_jetpack_memberships_contains_paid_content":false,"footnotes":""},"categories":[2],"tags":[],"class_list":["post-1496","post","type-post","status-publish","format-standard","hentry","category-ccra-news"],"jetpack_featured_media_url":"","jetpack_sharing_enabled":true,"jetpack_shortlink":"https:\/\/wp.me\/p69ory-o8","_links":{"self":[{"href":"http:\/\/ccra.us\/wp-json\/wp\/v2\/posts\/1496","targetHints":{"allow":["GET"]}}],"collection":[{"href":"http:\/\/ccra.us\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"http:\/\/ccra.us\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"http:\/\/ccra.us\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"http:\/\/ccra.us\/wp-json\/wp\/v2\/comments?post=1496"}],"version-history":[{"count":2,"href":"http:\/\/ccra.us\/wp-json\/wp\/v2\/posts\/1496\/revisions"}],"predecessor-version":[{"id":345325,"href":"http:\/\/ccra.us\/wp-json\/wp\/v2\/posts\/1496\/revisions\/345325"}],"wp:attachment":[{"href":"http:\/\/ccra.us\/wp-json\/wp\/v2\/media?parent=1496"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"http:\/\/ccra.us\/wp-json\/wp\/v2\/categories?post=1496"},{"taxonomy":"post_tag","embeddable":true,"href":"http:\/\/ccra.us\/wp-json\/wp\/v2\/tags?post=1496"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}